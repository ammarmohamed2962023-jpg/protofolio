// Prisma Schema - Portfolio Enterprise CMS (Phase 2B Career & Skills Engine)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ──

enum UserRole {
  ADMIN
  EDITOR
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  MANAGE
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum SettingCategory {
  SEO
  CONTACT
  SOCIAL
  UI
  ANALYTICS
  SYSTEM
}

enum SkillCategoryType {
  PROGRAMMING
  WEB
  NETWORKING
  DATABASE
  TOOLS
  SOFT_SKILLS
}

enum ProjectStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ── AUTH & USER MODELS ──

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  name            String
  avatar          String?
  role            UserRole       @default(EDITOR)
  isEmailVerified Boolean        @default(false)
  deletedAt       DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  sessions        Session[]
  activityLogs    ActivityLog[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  blogPosts       BlogPost[]
  projectVersions ProjectVersion[]

  @@index([email])
  @@index([role])
  @@index([deletedAt])
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  action      PermissionAction
  resource    String

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rolePermissions RolePermission[]

  @@index([resource, action])
}

model RolePermission {
  id           String     @id @default(cuid())
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([role, permissionId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([sessionToken])
}

// ── AUDIT & ACTIVITY LOGS ──

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  ipAddress String?
  userAgent String?
  browser   String?
  os        String?
  device    String?
  method    String?
  route     String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  action         String
  entity         String
  entityId       String?
  previousValues Json?
  newValues      Json?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  ipAddress      String?
  userAgent      String?
  browser        String?
  os             String?
  device         String?
  method         String?
  route          String?

  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model Setting {
  id          String          @id @default(cuid())
  key         String          @unique
  value       Json
  category    SettingCategory @default(SYSTEM)
  type        String          @default("string")
  description String?
  isPublic    Boolean         @default(false)
  validation  Json?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([key])
  @@index([category])
}

// ── DOMAIN & CAREER MODELS (PHASE 2B) ──

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  icon      String?
  order     Int      @default(0)
  isVisible Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model ResumeVersion {
  id             String   @id @default(cuid())
  version        String   @unique
  title          String
  fileUrl        String
  isActive       Boolean  @default(false)
  downloadsCount Int      @default(0)
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  deletedAt      DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
  @@index([deletedAt])
}

model SkillCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String?
  color       String?   @default("var(--accent-cyan)")
  order       Int       @default(0)
  skills      Skill[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([order])
}

model Skill {
  id          String         @id @default(cuid())
  name        String         @unique
  level       Int            @default(100)
  years       Int            @default(1)
  color       String?
  icon        String?
  order       Int            @default(0)
  isVisible   Boolean        @default(true)
  deletedAt   DateTime?

  categoryId  String?
  category    SkillCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([order])
  @@index([isVisible])
  @@index([deletedAt])
}

model Experience {
  id           String    @id @default(cuid())
  company      String
  position     String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  description  String
  technologies String[]
  order        Int       @default(0)
  deletedAt    DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([order])
  @@index([deletedAt])
}

model Education {
  id           String    @id @default(cuid())
  institution  String
  degree       String
  fieldOfStudy String
  startDate    DateTime
  endDate      DateTime?
  description  String?
  order        Int       @default(0)
  deletedAt    DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([order])
  @@index([deletedAt])
}

// ── PROJECTS MANAGEMENT SYSTEM (PHASE 2A) ──

model ProjectCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String?
  color       String?   @default("var(--accent-cyan)")
  order       Int       @default(0)
  projects    Project[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([order])
}

model Technology {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String?
  color       String?   @default("var(--accent-blue)")
  projects    Project[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Tag {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  projects    Project[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id             String                @id @default(cuid())
  title          String
  slug           String                @unique
  summary        String
  description    String
  coverImage     String?
  demoUrl        String?
  githubUrl      String?
  featured       Boolean               @default(false)
  featuredOrder  Int                   @default(0)
  pinned         Boolean               @default(false)
  status         ProjectStatus         @default(DRAFT)
  version        Int                   @default(1)
  order          Int                   @default(0)
  client         String?
  projectType    String?               @default("Web Application")
  completionDate DateTime?
  linkStatus     String?               @default("valid")

  seoTitle       String?
  seoDescription String?
  ogImage        String?
  seoScore       Int                   @default(0)

  deletedAt      DateTime?

  categoryId     String?
  category       ProjectCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  technologies   Technology[]
  tags           Tag[]
  images         ProjectImage[]
  versions       ProjectVersion[]
  slugRedirects  ProjectSlugRedirect[]
  analytics      ProjectAnalytics?

  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([slug])
  @@index([status])
  @@index([featured, featuredOrder])
  @@index([deletedAt])
}

model ProjectImage {
  id              String   @id @default(cuid())
  url             String
  altText         String?
  caption         String?
  order           Int      @default(0)
  isCover         Boolean  @default(false)
  isThumbnail     Boolean  @default(false)
  width           Int?
  height          Int?
  blurPlaceholder  String?
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([projectId, order])
}

model ProjectVersion {
  id            String   @id @default(cuid())
  version       Int
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedById   String?
  changedBy     User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changeSummary String
  snapshot      Json

  createdAt     DateTime @default(now())

  @@index([projectId, version])
}

model ProjectSlugRedirect {
  id        String   @id @default(cuid())
  oldSlug   String   @unique
  newSlug   String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([oldSlug])
}

model ProjectAnalytics {
  id             String   @id @default(cuid())
  projectId      String   @unique
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  views          Int      @default(0)
  clicks         Int      @default(0)
  githubClicks   Int      @default(0)
  liveDemoClicks Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Certificate {
  id           String    @id @default(cuid())
  title        String
  issuer       String
  issueDate    DateTime
  credentialId String?
  verifyUrl    String?
  imageUrl     String?
  order        Int       @default(0)
  deletedAt    DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([issuer])
}

model BlogPost {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  summary     String
  content     String
  coverImage  String?
  tags        String[]
  status      BlogPostStatus @default(PUBLISHED)
  viewsCount  Int            @default(0)
  authorId    String?
  author      User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  deletedAt   DateTime?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([slug])
  @@index([status])
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([isRead])
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  provider  String   @default("local")
  publicId  String?

  createdAt DateTime @default(now())

  @@index([provider])
}
